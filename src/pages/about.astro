---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import Content2 from "@/components/widgets/Content2.astro";
import Values from "@/components/widgets/Values.astro";
import aboutImage from "@/assets/images/st-michaels-front.jpeg";
import { withBase } from "@/config/site";

const metadata = {
  title: "About us",
  description:
    "Learn more about our vision for the burial ground extension in Tintern.",
};

const values = [
  {
    title: "Improved Public Path",
    description:
      "Improve the public path alongside the river by reducing muddy sections and installing a public shelter for walkers.",
  },
  {
    title: "Upgrade Internal Paths",
    description:
      "Upgrade paths through the Churchyard to create accessible routes for funeral parties and members of the public",
  },
  {
    title: "New Access",
    description:
      "Create new access from the riverside path, allowing the public to enjoy new views and peaceful rest areas",
  },
  {
    title: "Better for Wildlife",
    description:
      "Add trees, hedging and planting to improve wildlife habitats and enhance the environment",
  },
  {
    title: "Memorial Tree",
    description:
      "Install a freestanding, tree-shaped outdoor steel structure to attach messages on personalised memorial leaves.",
  },
];

const optimizedImage = await getImage({
  src: aboutImage,
  format: "jpg",
});
---

<BaseLayout {metadata}>
  <link slot="head" rel="preload" href={optimizedImage.src} as="image" />
  <Content2
    title="Our Vision"
    description={[
      "The proposed burial ground extension will create a new area of peace and tranquillity beside the River Wye for villagers, walkers and the families of local people who have found their final resting place.",
    ]}
    tagline="About"
    image={aboutImage}
    imageAlt="Modern web development office"
    actions={[
      {
        text: "Contact Us",
        href: withBase("/contact/"),
        variant: "primary",
        icon: "lucide:mail",
      },
    ]}
  />
  <Values
    items={values}
    columns={2}
    tagline="The advantages"
    title="Why do this?"
  />
</BaseLayout>
